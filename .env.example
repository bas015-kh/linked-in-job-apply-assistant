# Local development defaults. Replace passwords in an untracked .env.
POSTGRES_USER=applypilot
POSTGRES_PASSWORD=replace_with_a_long_random_local_password
POSTGRES_DB=applypilot
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Keep mock until all webhook paths and the shared secret are configured and tested.
N8N_MODE=mock
N8N_BASE_URL=
N8N_PROFILE_WEBHOOK_PATH=
N8N_JOB_EVALUATION_WEBHOOK_PATH=
N8N_APPROVAL_WEBHOOK_PATH=
N8N_WEBHOOK_SECRET=
